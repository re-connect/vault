meta {
  name: Update
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/api/v3/notes/{{noteId}}
  body: json
  auth: inherit
}

body:json {
  {
    "nom": "Ma note",
    "contenu": "Nouveau contenu"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Remplace `PUT /api/v2/notes/{id}` : seuls les champs envoyés sont modifiés.
}
