meta {
  name: Create
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v3/notes
  body: json
  auth: inherit
}

body:json {
  {
    "nom": "Ma note",
    "contenu": "Contenu de la note",
    "b_prive": false,
    "beneficiaire_id": {{beneficiaryId}}
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Remplace `POST /api/v2/beneficiaries/{id}/notes`. `beneficiaire_id` est obligatoire pour un pro, ignoré pour un bénéficiaire. 201.
}
