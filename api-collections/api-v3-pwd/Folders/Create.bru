meta {
  name: Create
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v3/folders
  body: json
  auth: inherit
}

body:json {
  {
    "nom": "Nouveau dossier",
    "beneficiaire_id": {{beneficiaryId}},
    "icon": "/api/v3/folder_icons/{{folderIconId}}"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Remplace `POST /api/v2/beneficiaries/{id}/folders`. `beneficiaire_id` est obligatoire pour un pro, ignoré pour un bénéficiaire. `dossier_parent_id` crée un sous-dossier (qui hérite de la confidentialité du parent). 201.
}
