meta {
  name: Create
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v3/contacts
  body: json
  auth: inherit
}

body:json {
  {
    "nom": "Dupont",
    "prenom": "Jean",
    "telephone": "0600000000",
    "email": "jean.dupont@example.com",
    "association": "",
    "commentaire": "",
    "b_prive": false,
    "beneficiaire_id": {{beneficiaryId}}
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Remplace `POST /api/v2/beneficiaries/{id}/contacts`. `beneficiaire_id` est obligatoire pour un pro, ignoré pour un bénéficiaire. 201.
}
