meta {
  name: Update
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/api/v3/contacts/{{contactId}}
  body: json
  auth: inherit
}

body:json {
  {
    "telephone": "0611223344"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Remplace `PUT /api/v2/contacts/{id}` : seuls les champs envoyés sont modifiés.
}
