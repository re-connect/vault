meta {
  name: Leave
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/api/v3/centers/{{centerId}}/leave
  body: none
  auth: inherit
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Remplace `PATCH /api/v2/users/{userId}/centers/{id}/leave` : plus d'id utilisateur dans le chemin. 404 si l'utilisateur n'est pas lié au centre.
}
