meta {
  name: Create
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v3/beneficiaries
  body: json
  auth: inherit
}

body:json {
  {
    "first_name": "Jean",
    "last_name": "Dupont",
    "birth_date": "1990-01-31",
    "email": "jean.dupont@example.com",
    "phone": "0600000000",
    "password": "{{newPassword}}",
    "secret_question": "Quel est le nom de votre premier animal ?",
    "secret_question_answer": "Rex",
    "centers": ["{{centerId}}"]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Remplace `POST /api/v2/beneficiaries`. Réservé aux pros qui gèrent les bénéficiaires. `centers` est obligatoire et ne doit contenir que des centres où le pro gère les bénéficiaires (sinon 422) ; les liens sont acceptés d'office. `birth_date` au format `yyyy-MM-dd`. 201.
}
