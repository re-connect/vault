meta {
  name: Update password
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v3/users/me/update_password
  body: json
  auth: inherit
}

body:json {
  {
    "password": "{{newPassword}}"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Remplace `PATCH /api/v2/user/password`. 400 `{"password": "missing|weak"}` si absent ou trop faible.
}
