meta {
  name: Share
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v3/documents/{{documentId}}/share
  body: json
  auth: inherit
}

body:json {
  {
    "email": "destinataire@example.com"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Remplace `POST /api/v2/documents/{id}/share`. 204 ; 400 si `email` manque.
}
