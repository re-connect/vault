meta {
  name: List
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v3/beneficiaries/{{beneficiaryId}}/documents
  body: none
  auth: inherit
}

params:query {
  ~folderId: root
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Remplace `GET /api/v2/beneficiaries/{id}/documents`. Ne renvoie que les documents (les dossiers sont dans Folders/List). Filtre `folderId` (en camelCase) : `root` ou un id de dossier. Un pro ne voit que les documents partagés.
}
