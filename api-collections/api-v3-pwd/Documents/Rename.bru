meta {
  name: Rename
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/api/v3/documents/{{documentId}}
  body: json
  auth: inherit
}

body:json {
  {
    "nom": "Nouveau nom"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Remplace `PATCH /api/v2/documents/{id}`. Le serveur normalise le nom (`Nouveau nom` devient `Nouveau_nom.<extension>`).
}
