meta {
  name: Upload
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v3/documents
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  file: @file()
  ~beneficiary_id: {{beneficiaryId}}
  ~folder_id: {{folderId}}
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Remplace `POST /api/beneficiaries/{id}/documents`. Un fichier par appel (champ `file`). Un bénéficiaire dépose pour lui-même ; un pro doit donner `beneficiary_id`. `folder_id` optionnel. 201 ; 400 si le fichier est refusé.
}
