meta {
  name: Get
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v3/documents/{{documentId}}
  body: none
  auth: inherit
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Remplace `GET /api/v2/documents/{id}` et `GET /api/v2/documents/{id}/{size}` : les liens vers le fichier et la miniature sont dans `url` et `thumb`.
}
