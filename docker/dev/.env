# Shared by all developers: local, non-secret values only.
# Injected into the container, these take precedence over .env / .env.local:
# only Docker-specific values are defined here.
APP_ENV=dev
APP_DEBUG=1
XDEBUG_MODE=off
APP_ROOT_URL=https://dev.vault.local:8443

DATABASE_URL=mysql://vault:vault@vault-db:3306/vault_dev?serverVersion=mariadb-10.4.12
MAILER_DSN=smtp://mailpit:1025

BUCKET_HOST=https://minio.vault.local:8443
BUCKET_NAME=vault-dev
BUCKET_KEY=minioadmin
BUCKET_SECRET=minioadmin
BUCKET_ACCESS_KEY=minioadmin
BUCKET_SECRET_KEY=minioadmin

# Not used by the application yet (clamdscan check is disabled) — ready for the ClamavScanner port
CLAMAV_DSN=tcp://vault-clamav:3310

# nginx forwards X-Forwarded-Proto/Port: trust it so Symfony generates https://…:8443 URLs
SYMFONY_TRUSTED_PROXIES=private_ranges

# Outgoing channels neutralised locally: never reach real people or third-party services
BREVO_DSN=null://null
MJ_APIKEY_PUBLIC=disabled
MJ_APIKEY_PRIVATE=disabled
ROSALIE_BASE_URL=http://localhost:9
ROSALIE_BASIC_TOKEN=disabled
