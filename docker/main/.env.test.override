# Test container only (replaces docker/main/.env). Everything else comes from .env / .env.test.
APP_ENV=test
XDEBUG_MODE=off
PARATEST_PROCESSES=4
# Container name instead of the "mariadb" service name, which vault-db also answers to on vault_shared_db.
# root is required so paratest workers can create their own vault_test<N> databases.
# Doctrine appends the "_test" suffix: the database is vault_test.
DATABASE_URL=mysql://root:vault@vault-main-test-db:3306/vault?serverVersion=mariadb-10.4.12
