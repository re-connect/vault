<div class="row alert alert-dismissible fade show py-1 mt-2 shadow {{ bgColor }} {{ textColor }}"
     role="{{ key in ['error', 'danger', 'warning'] ? 'alert' : 'status' }}"
     data-flash-message-target="alert"
>
    <div class="col-10 bold px-4 pt-3">
        <small>{{ getFlashMessageTitle(key)|upper }}</small>
    </div>
    <button type="button" class="btn-close pe-5" data-bs-dismiss="alert" aria-label="Close"></button>
    <div class="px-4 pb-3 mt-2">
        <small>{{ flashMessage|trans()|raw }}</small>
    </div>
</div>
