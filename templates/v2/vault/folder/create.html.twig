{% extends 'v2/vault/standard_layout.html.twig' %}

{% block metaTitle %}{{ 'documents'|trans }} - {{ 'create_folder'|trans }}{% endblock metaTitle %}

{% block metas %}
    <meta name="turbo-cache-control" content="no-preview">
{% endblock %}

{% block content %}
    <div {{ stimulus_controller('autocomplete', {'source': autocompleteNames})|stimulus_controller('folder-icon') }}>
        {{ include('v2/vault/form/_personal_data_form.html.twig', {
            title: 'create_folder',
            section: 'documents',
            icon : 'fas fa-folder-plus',
            cancelPath: path('list_documents', {'id': folder.beneficiaire.id}),
        }) }}
    </div>
{% endblock %}
