{% if document.extension in ['doc', 'docx', 'txt', 'odt'] %}
    {% set url = asset('build/images/icons/word.png') %}
{% elseif document.extension in ['xls', 'xlsx', 'csv'] %}
    {% set url = asset('build/images/icons/excel.PNG') %}
{% endif %}
{% set thumbnailUrl = document.thumbnailPresignedUrl ?? url ?? null %}

<span class="d-flex justify-content-center align-items-center rounded thumbnail-size">
    {% if thumbnailUrl %}
        <img class="img-fluid bg-white rounded shadow-sm p-1 thumbnail-size border rounded" src="{{ thumbnailUrl }}"
             alt="{{ document.nom }}"
        />
    {% else %}
        <span class="d-block bg-white rounded shadow-sm p-1 thumbnail-size border rounded">
            <span class="visually-hidden">{{ document.nom }}</span>
        </span>
    {% endif %}
</span>
