<!DOCTYPE html>
{% set page_locale = app.request ? app.request.locale : 'fr' %}
{# Arabic, Pashto and Dari are read from right to left (RGAA 8.10) #}
<html lang="{{ page_locale }}" dir="{{ page_locale in ['ar', 'ps', 'prs'] ? 'rtl' : 'ltr' }}">
<head>
    <title>{% block metaTitle %}{{ 'vault_meta_title'|trans }}{% endblock metaTitle %}
        - {{ 'reconnect'|trans }}</title>

    {{ include('v2/common/_metas.html.twig') }}

    {% block styles %}
        {{ encore_entry_link_tags('appV2style') }}
    {% endblock %}

    {% block javascripts %}
        {{ encore_entry_script_tags('appV2') }}
        {{ include('v2/common/_crisp.html.twig') }}
    {% endblock javascripts %}

    {{ include('favicons.html.twig') }}
</head>
<body class="d-flex flex-column" data-turbo-prefetch="false" {{ stimulus_controller('tooltip') }}>
{{ include('v2/header/header.html.twig') }}

<main role="main" id="main-content" class="position-relative {% block bodyColor %}{{ getUserBackgroundColor() }}{% endblock %} pb-5">
    {{ include('v2/flash_messages.html.twig') }}
    {% block notifications %}{{ include('v2/common/_notifications.html.twig') }}{% endblock %}

    {% block body %}{% endblock body %}
</main>

{{ include('v2/footer.html.twig') }}
</body>
</html>
