{% use 'bootstrap_5_layout.html.twig' %}

{% block form_row -%}
    {%- if compound is defined and compound -%}
        {%- set element = 'fieldset' -%}
        {%- if label is same as(false) -%}
            {#- No legend to give: the fieldset only wraps the fields, it is not exposed as a group -#}
            {%- set row_attr = row_attr|merge({role: 'presentation'}) -%}
        {%- endif -%}
    {%- endif -%}
    {%- set widget_attr = {} -%}
    {%- set described_by = help is not empty ? [id ~ '_help'] : [] -%}
    {%- if not compound and errors|length > 0 -%}
        {%- for error in errors -%}
            {%- set described_by = described_by|merge([id ~ '_error' ~ loop.index]) -%}
        {%- endfor -%}
    {%- endif -%}
    {%- if described_by is not empty -%}
        {%- set widget_attr = {attr: attr|merge({'aria-describedby': described_by|join(' ')})|merge(errors|length > 0 and not compound ? {'aria-invalid': 'true'} : {})} -%}
    {%- endif -%}
    {%- set row_class = row_class|default(row_attr.class|default('my-1')|trim) -%}
    <{{ element|default('div') }}{% with {attr: row_attr|merge({class: row_class})} %}{{ block('attributes') }}{% endwith %}>
    {%- if 'form-floating' in row_class -%}
        {{- form_widget(form, widget_attr) -}}
        {{- form_label(form) -}}
    {%- else -%}
        {{- form_label(form) -}}
        {{- form_widget(form, widget_attr) -}}
    {%- endif -%}
    {{- form_help(form) -}}
    {{- form_errors(form) -}}
    </{{ element|default('div') }}>
{%- endblock %}

{%- block form_label -%}
    {% if label is not same as(false) -%}
        {% if not compound -%}
            {% set label_attr = label_attr|merge({'for': id}) %}
        {%- else -%}
            {% set element = 'legend' %}
            {% set label_attr = label_attr|merge({'class': (label_attr.class|default('') ~ ' legend-as-label')|trim}) %}
        {%- endif -%}
        {% if required -%}
            {% set label_attr = label_attr|merge({'class': (label_attr.class|default('') ~ ' required')|trim}) %}
        {%- endif -%}
        {% if label is empty -%}
            {%- if label_format is not empty -%}
                {% set label = label_format|replace({
                    '%name%': name,
                    '%id%': id,
                }) %}
            {%- else -%}
                {% set label = name|humanize %}
            {%- endif -%}
        {%- endif -%}
        <{{ element|default('label') }}{% if label_attr %}{% with { attr: label_attr } %}{{ block('attributes') }}{% endwith %}{% endif %}>
        {%- if translation_domain is same as(false) -%}
            {%- if label_html is same as(false) -%}
                {{- label -}}
            {%- else -%}
                {{- label|raw -}}
            {%- endif -%}
        {%- else -%}
            {%- if label_html is same as(false) -%}
                {{- label|trans(label_translation_parameters, translation_domain) -}}
            {%- else -%}
                {{- label|trans(label_translation_parameters, translation_domain)|raw -}}
            {%- endif -%}
        {%- endif -%}
        {{- block('required_asterisk') -}}
        </{{ element|default('label') }}>
    {%- endif -%}
{%- endblock form_label -%}

{%- block form_label_content -%}
    {{- parent() -}}
    {{- block('required_asterisk') -}}
{%- endblock form_label_content -%}

{%- block required_asterisk -%}
    {%- if required -%}<span class="required-asterisk" aria-hidden="true">*</span>{%- endif -%}
{%- endblock required_asterisk -%}
